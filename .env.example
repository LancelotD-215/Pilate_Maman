# ============================================================
# Modèle des variables d'environnement pour l'application.
# À COPIER en un fichier .env (non versionné) et à remplir avec
# les vraies valeurs de l'environnement (dev / prod).
#
# En local :
#   copy .env.example .env     (Windows PowerShell)
#   cp .env.example .env       (Mac / Linux)
# ============================================================

# Clé de signature des cookies de session Flask (obligatoire).
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Identifiants admin de l'espace de gestion (obligatoires).
# Générer le hash du mot de passe avec : python set_admin_password.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Nom du site affiché en haut de chaque page (optionnel, valeur par défaut = "Gestion Pilates").
SITE_NAME=Gestion Pilates

# Environnement actif : "development" (local) ou "production" (serveur).
# En production, le mode debug est désactivé automatiquement.
FLASK_ENV=development
